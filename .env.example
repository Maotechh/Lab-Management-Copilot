# -------------------------------------------------------------
# 耗材智能管理助手 - 环境变量配置示例 (.env.example)
#
# 请将此文件复制并重命名为 `.env.local`，然后填入你的真实参数。
# 切勿将真实的 `.env.local` 提交到版本库！
# -------------------------------------------------------------

# [可选] 校内 GenAI 主接口 API Key。留空时仍会尝试代码内置的校内直连接口。
GENAI_API_KEY=""

# [可选] 大模型的名称。
# 例如：deepseek-pro, gpt-4o, claude-3-5-sonnet 等，默认为 deepseek-pro
GENAI_MODEL="deepseek-pro"

# [可选] 大模型调用的模式。
# 支持 completion (用于标准对话模型) 或 response (用于支持 structured output 的模型)
GENAI_MODE="completion"

# [可选] API 基础 URL 覆盖。如果不使用官方源或做了本地转发，可在此修改。
GENAI_BASE_URL=""

# [可选] API 调用的最大超时时间（秒），默认 10 秒。
GENAI_TIMEOUT=10

# AI requests remain required; rule parsing is not reported as AI availability.
GENAI_REQUIRED=1
# Optional approved models on the same institutional endpoint, comma separated.
GENAI_FALLBACK_MODELS=""
# Optional JSON array that replaces the built-in school model endpoints.
# Leave unset to use the configured institutional endpoint plus Qwen, GLM, DeepSeek and Kimi fallbacks.
GENAI_FALLBACK_PROVIDERS_JSON=""
# Bound the total time spent across providers and each provider request.
GENAI_TOTAL_TIMEOUT=75
GENAI_PROVIDER_TIMEOUT=10
# Configure after the institution supplies a trusted HTTPS domain.
PUBLIC_BASE_URL=""
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT=""
