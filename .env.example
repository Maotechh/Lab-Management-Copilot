# -------------------------------------------------------------
# 耗材智能管理助手 - 环境变量配置示例 (.env.example)
#
# 请将此文件复制并重命名为 `.env.local`，然后填入你的真实参数。
# 切勿将真实的 `.env.local` 提交到版本库！
# -------------------------------------------------------------

# 学校 Responses 接口不需要 API Key。
GENAI_API_KEY=""

# [可选] 大模型的名称。
# 例如：deepseek-pro, gpt-4o, claude-3-5-sonnet 等，默认为 deepseek-pro
GENAI_MODEL="deepseek-pro"

# 学校模型使用 Responses API。
GENAI_MODE="responses"

# 学校模型 API 基础 URL。程序请求 POST /v1/responses。
GENAI_BASE_URL="http://10.15.171.204:30969/v1"

# API 请求最多等待五分钟。
GENAI_TIMEOUT=300

# AI requests remain required; rule parsing is not reported as AI availability.
GENAI_REQUIRED=1
# Set to 1 only after a teacher confirms the institutional stock records.
CONSUMABLE_INVENTORY_CONFIRMED=0
# Keep these empty until an alternative provider has passed capability checks.
GENAI_FALLBACK_MODELS=""
# Do not configure unverified alternative providers.
GENAI_FALLBACK_PROVIDERS_JSON=""
# Bound the total time spent across providers and each provider request.
GENAI_MAX_OUTPUT_TOKENS=65536
GENAI_TOTAL_TIMEOUT=300
GENAI_PROVIDER_TIMEOUT=300
# Configure after the institution supplies a trusted HTTPS domain.
PUBLIC_BASE_URL=""
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT=""
