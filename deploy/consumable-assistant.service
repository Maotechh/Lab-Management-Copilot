[Unit]
Description=Lab Management Copilot
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=lab-management
Group=lab-management
SupplementaryGroups=lab-analysis-client
WorkingDirectory=/opt/lab-management/current
Environment=HOME=/var/lib/lab-management
Environment=CONSUMABLE_DB_PATH=/var/lib/lab-management/consumables.db
Environment=CONSUMABLE_PROFILE=production
Environment=CONSUMABLE_AUTO_SEED=0
Environment=PYTHONDONTWRITEBYTECODE=1
EnvironmentFile=-/etc/lab-management/environment
ExecStart=/opt/lab-management/current/.venv/bin/uvicorn consumable_assistant.server:app --host 127.0.0.1 --port 8000 --workers 1 --proxy-headers --forwarded-allow-ips 127.0.0.1
Restart=on-failure
RestartSec=3
TimeoutStopSec=30
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/lab-management
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
