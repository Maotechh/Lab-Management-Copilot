[Unit]
Description=Deploy CI-verified laboratory application commits from GitHub
Wants=network-online.target
After=network-online.target
ConditionPathExists=/etc/lab-management-autoupdate/config.json
RequiresMountsFor=/opt/lab-management/releases /var/backups/lab-management /var/cache/lab-management-autoupdate

[Service]
Type=oneshot
User=root
UMask=0077
ExecStart=/usr/bin/python3 /usr/local/lib/lab-management-autoupdate/autoupdate.py
TimeoutStartSec=infinity
TimeoutStopSec=30min
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
StandardOutput=journal
StandardError=journal
